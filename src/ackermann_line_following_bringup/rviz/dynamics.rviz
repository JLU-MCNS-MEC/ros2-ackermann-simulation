Panels:
  - Class: rviz_common/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /Lidar1
        - /Trajectory1
        - /Dynamics Path1
        - /RGBD PointCloud1
      Splitter Ratio: 0.45
  - Class: rviz_common/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.35
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 160; 160; 164
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid
      Normal Cell Count: 0
      Offset:
        X: 0
        Y: 0
        Z: 0
      Plane: XY
      Plane Cell Count: 20
      Reference Frame: <Fixed Frame>
      Value: true
    - Class: rviz_default_plugins/RobotModel
      Enabled: true
      Name: Robot
      Robot Description: robot_description
      TF Prefix: ""
      Value: true
    - Alpha: 1
      Class: rviz_default_plugins/LaserScan
      Color: 255; 40; 40
      Enabled: true
      Name: Lidar
      Queue Size: 10
      Size (Pixels): 3
      Style: Flat Squares
      Topic: /scan
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.8
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Class: rviz_default_plugins/PointCloud2
      Color Transformer: RGB8
      Enabled: true
      Name: RGBD PointCloud
      Position Transformer: XYZ
      Queue Size: 3
      Selectable: true
      Size (Pixels): 2
      Style: Flat Squares
      Topic: /rgbd/points
      Use Fixed Frame: true
      Value: true
    - Alpha: 0.9
      Autocompute Intensity Bounds: true
      Autocompute Value Bounds:
        Max Value: 10
        Min Value: -10
        Value: true
      Axis: Z
      Channel Name: intensity
      Class: rviz_default_plugins/PointCloud2
      Color: 255; 170; 40
      Color Transformer: Intensity
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 4096
      Min Color: 0; 0; 0
      Min Intensity: 0
      Name: MID360 PointCloud
      Position Transformer: XYZ
      Queue Size: 5
      Selectable: true
      Size (Pixels): 2
      Style: Flat Squares
      Topic: /scan/points
      Use Fixed Frame: true
      Use rainbow: false
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: RGB Image
      Normalize Range: false
      Queue Size: 2
      Topic: /rgbd/image
      Transport Hint: raw
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: false
      Name: Depth Image
      Normalize Range: true
      Queue Size: 2
      Topic: /rgbd/depth_image
      Transport Hint: raw
      Value: true
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Frame Timeout: 15
      Marker Scale: 0.3
      Show Arrows: true
      Show Axes: true
      Show Names: false
      Update Interval: 0
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 220; 40
      Enabled: true
      Name: Trajectory
      Topic: /trajectory
      Value: true
      Line Style: Lines
      Line Width: 0.04
      Buffer Length: 1
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Waypoint Target
      Namespaces:
        waypoint_tracker: true
      Topic: /waypoint_target
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 80; 180; 255
      Enabled: true
      Name: Dynamics Path
      Topic: /dynamics_trajectory
      Value: true
      Line Style: Lines
      Line Width: 0.05
      Buffer Length: 1
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Dynamics Phase
      Namespaces:
        ackermann_dynamics: true
      Topic: /dynamics_phase
      Value: true
  Enabled: true
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
    - Class: rviz_default_plugins/SetInitialPose
      Topic: /initialpose
    - Class: rviz_default_plugins/SetGoal
      Topic: /goal_pose
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic: /clicked_point
  Value: true
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 8
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Focal Point:
        X: 0
        Y: 0
        Z: 0.4
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.05
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Pitch: 0.65
      Target Frame: <Fixed Frame>
      Value: Orbit (rviz)
      Yaw: 3.9
    Saved: ~
Window Geometry:
  Height: 900
  Width: 1400
  X: 80
  Y: 80
