<?xml version="1.0"?>
<sdf version="1.8">
  <world name="dynamics_test">
    <!-- Open-field test track for reversible longitudinal and steering motion. -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation><range>1000</range><constant>0.9</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>60 30</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>60 30</size></plane></geometry>
          <material><ambient>0.35 0.35 0.35 1</ambient><diffuse>0.35 0.35 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Visual-only lane stripes make steering and reverse motion obvious. -->
    <model name="test_lane_markings">
      <static>true</static>
      <link name="link">
        <visual name="centerline"><pose>0 0 0.003 0 0 0</pose><geometry><box><size>14 0.035 0.006</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="left_lane"><pose>0 1.5 0.003 0 0 0</pose><geometry><box><size>14 0.025 0.006</size></box></geometry>
          <material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.15 0.55 0.95 1</diffuse></material>
        </visual>
        <visual name="right_lane"><pose>0 -1.5 0.003 0 0 0</pose><geometry><box><size>14 0.025 0.006</size></box></geometry>
          <material><ambient>0.15 0.55 0.95 1</ambient><diffuse>0.15 0.55 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Side reference blocks give the 360-degree lidar finite returns without
         placing a collision in the reversible test path. -->
    <model name="left_reference_block"><static>true</static><pose>-2.5 2.5 0.3 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.1 0.4 0.9 1</ambient><diffuse>0.1 0.4 0.9 1</diffuse></material></visual>
    </link></model>
    <model name="right_reference_block"><static>true</static><pose>1.5 -2.5 0.3 0 0 0</pose><link name="link">
      <collision name="collision"><geometry><box><size>0.6 0.6 0.6</size></box></geometry></collision>
      <visual name="visual"><geometry><box><size>0.6 0.6 0.6</size></box></geometry><material><ambient>0.9 0.25 0.1 1</ambient><diffuse>0.9 0.25 0.1 1</diffuse></material></visual>
    </link></model>
  </world>
</sdf>
