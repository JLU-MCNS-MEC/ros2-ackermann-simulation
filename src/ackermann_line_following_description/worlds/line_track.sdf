<?xml version="1.0"?>
<sdf version="1.8">
  <world name="line_track">
    <!-- Use Gazebo's default physics engine (DART on this ROS/Gazebo pairing). -->
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode><mu>1.5</mu><mu2>1.5</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.78 0.78 0.78 1</ambient>
            <diffuse>0.78 0.78 0.78 1</diffuse>
            <specular>0.15 0.15 0.15 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- A rounded rectangle made from overlapping visual-only segments.  The
         1 m corner radius is within the steering envelope of this car, and
         the single marking model makes it easy to replace the track later. -->
    <model name="line_track_marking">
      <static>true</static>
      <link name="link">
        <visual name="entry">
          <pose>-2.2 0 0.002 0 0 0</pose>
          <geometry><box><size>2.08 0.14 0.004</size></box></geometry>
          <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material>
        </visual>
        <visual name="bottom_straight">
          <pose>-0.3 0 0.002 0 0 0</pose>
          <geometry><box><size>1.88 0.14 0.004</size></box></geometry>
          <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material>
        </visual>
        <visual name="bottom_right_0">
          <pose>0.729 0.017 0.002 0 0 0.131</pose>
          <geometry><box><size>0.341 0.14 0.004</size></box></geometry>
          <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material>
        </visual>
        <visual name="bottom_right_1">
          <pose>0.979 0.084 0.002 0 0 0.393</pose>
          <geometry><box><size>0.341 0.14 0.004</size></box></geometry>
          <material><ambient>0.015 0.015 0.015 1</ambient><diffuse>0.015 0.015 0.015 1</diffuse></material>
        </visual>
        <visual name="bottom_right_2">
          <pose>1.204 0.213 0.002 0 0 0.654</pose>
