<?xml version="1.0"?>
<sdf version="1.8">
  <world name="unknown_obstacle">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <!-- Keep /clock and sensor TF at wall-clock pace. Without an explicit
           update rate Gazebo can run ahead of ros_gz_bridge on CPU-only
           machines, leaving Nav2 with stale transforms. -->
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 8 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>30 30</size></plane>
          </geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>30 30</size></plane></geometry>
          <material>
            <ambient>0.72 0.72 0.72 1</ambient>
            <diffuse>0.72 0.72 0.72 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- The red box blocks the straight trajectory and leaves room on both sides. -->
    <model name="center_obstacle">
      <static>true</static>
      <pose>0.65 0 0.45 0 0 0</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.70 0.85 0.90</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.70 0.85 0.90</size></box></geometry>
          <material><ambient>0.80 0.08 0.04 1</ambient><diffuse>0.80 0.08 0.04 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
