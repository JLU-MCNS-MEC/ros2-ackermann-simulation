<?xml version="1.0"?>
<sdf version="1.8">
  <world name="complex_static">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows><pose>0 0 15 0 0 0</pose>
      <diffuse>0.95 0.95 0.95 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
    <model name="ground_plane">
      <static>true</static><link name="link">
        <collision name="collision"><geometry><plane><normal>0 0 1</normal><size>32 22</size></plane></geometry>
          <surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
        <visual name="visual"><geometry><plane><normal>0 0 1</normal><size>32 22</size></plane></geometry>
          <material><ambient>0.68 0.68 0.68 1</ambient><diffuse>0.68 0.68 0.68 1</diffuse></material></visual>
      </link>
    </model>

    <!-- Boundary and shelves match complex_static.pgm exactly. -->
    <model name="wall_west"><static>true</static><pose>-14.85 0 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 20 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 20 0.8</size></box></geometry><material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material></visual></link></model>
    <model name="wall_east"><static>true</static><pose>14.85 0 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>0.3 20 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>0.3 20 0.8</size></box></geometry><material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material></visual></link></model>
    <model name="wall_south"><static>true</static><pose>0 -9.85 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>30 0.3 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>30 0.3 0.8</size></box></geometry><material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material></visual></link></model>
    <model name="wall_north"><static>true</static><pose>0 9.85 0.4 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>30 0.3 0.8</size></box></geometry></collision><visual name="visual"><geometry><box><size>30 0.3 0.8</size></box></geometry><material><ambient>0.18 0.20 0.24 1</ambient><diffuse>0.18 0.20 0.24 1</diffuse></material></visual></link></model>

    <model name="shelf_a"><static>true</static><pose>-7 -4 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>6 1 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>6 1 1.2</size></box></geometry><material><ambient>0.15 0.35 0.75 1</ambient><diffuse>0.15 0.35 0.75 1</diffuse></material></visual></link></model>
    <model name="shelf_b"><static>true</static><pose>-2 -1 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1 7 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1 7 1.2</size></box></geometry><material><ambient>0.80 0.30 0.10 1</ambient><diffuse>0.80 0.30 0.10 1</diffuse></material></visual></link></model>
    <model name="shelf_c"><static>true</static><pose>2 4 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>7 1 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>7 1 1.2</size></box></geometry><material><ambient>0.15 0.55 0.25 1</ambient><diffuse>0.15 0.55 0.25 1</diffuse></material></visual></link></model>
    <model name="shelf_d"><static>true</static><pose>7 0 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1 7 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>1 7 1.2</size></box></geometry><material><ambient>0.65 0.15 0.55 1</ambient><diffuse>0.65 0.15 0.55 1</diffuse></material></visual></link></model>
    <model name="shelf_e"><static>true</static><pose>9.5 6 0.6 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>5 1 1.2</size></box></geometry></collision><visual name="visual"><geometry><box><size>5 1 1.2</size></box></geometry><material><ambient>0.75 0.60 0.10 1</ambient><diffuse>0.75 0.60 0.10 1</diffuse></material></visual></link></model>

    <model name="pillar_west"><static>true</static><pose>-11 2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 1.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 1.2 1.5</size></box></geometry><material><ambient>0.65 0.12 0.10 1</ambient><diffuse>0.65 0.12 0.10 1</diffuse></material></visual></link></model>
    <model name="pillar_north"><static>true</static><pose>3 7 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 1.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 1.2 1.5</size></box></geometry><material><ambient>0.10 0.55 0.60 1</ambient><diffuse>0.10 0.55 0.60 1</diffuse></material></visual></link></model>
    <model name="pillar_east"><static>true</static><pose>11 -2 0.75 0 0 0</pose><link name="link"><collision name="collision"><geometry><box><size>1.2 1.2 1.5</size></box></geometry></collision><visual name="visual"><geometry><box><size>1.2 1.2 1.5</size></box></geometry><material><ambient>0.55 0.20 0.15 1</ambient><diffuse>0.55 0.20 0.15 1</diffuse></material></visual></link></model>
  </world>
</sdf>
